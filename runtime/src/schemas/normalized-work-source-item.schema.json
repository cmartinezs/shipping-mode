{
  "$id": "https://shipping-mode.dev/schemas/normalized-work-source-item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "provider",
    "itemId",
    "type",
    "title",
    "description",
    "acceptanceCriteria",
    "status",
    "priority",
    "labels",
    "relationships",
    "dependencies",
    "assignee",
    "owner",
    "fields",
    "revision",
    "mappingVersion",
    "metadata",
    "trace"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "type": {
      "enum": [
        "user_story",
        "capability",
        "defect",
        "enabler",
        "spike",
        "compliance",
        "migration",
        "operational"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "description": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "text"
          ],
          "properties": {
            "format": {
              "enum": [
                "plain",
                "markdown"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            }
          }
        }
      ]
    },
    "acceptanceCriteria": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized",
        "providerStatus"
      ],
      "properties": {
        "normalized": {
          "enum": [
            "todo",
            "in_progress",
            "done",
            "cancelled",
            "unknown"
          ]
        },
        "providerStatus": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized",
        "providerPriority"
      ],
      "properties": {
        "normalized": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "providerPriority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "labels": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "relationships": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/typedRef"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/typedRef"
      }
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "fields": {
      "$ref": "#/$defs/canonicalFields"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updatedAt"
      ],
      "properties": {
        "externalRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contentRevision": {
          "$ref": "#/$defs/hash"
        },
        "fingerprint": {
          "$ref": "#/$defs/hash"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "externalRevision"
          ],
          "properties": {
            "externalRevision": {}
          }
        },
        {
          "type": "object",
          "required": [
            "contentRevision"
          ],
          "properties": {
            "contentRevision": {}
          }
        },
        {
          "type": "object",
          "required": [
            "fingerprint"
          ],
          "properties": {
            "fingerprint": {}
          }
        }
      ]
    },
    "mappingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32
    },
    "trace": {
      "oneOf": [
        {
          "$ref": "#/$defs/localTrace"
        },
        {
          "$ref": "#/$defs/externalTrace"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "user_story",
              "capability"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "const": "local_repository"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {}
        },
        "not": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {}
          }
        }
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {}
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "user_story"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "actor",
              "need",
              "value"
            ],
            "properties": {
              "actor": {},
              "need": {},
              "value": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "capability"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "outcome",
              "behavior"
            ],
            "properties": {
              "outcome": {},
              "behavior": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "defect"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "observedBehavior",
              "expectedBehavior",
              "reproduction",
              "severity"
            ],
            "properties": {
              "observedBehavior": {},
              "expectedBehavior": {},
              "reproduction": {},
              "severity": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "enabler"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "technicalOutcome",
              "unlockedCapabilities"
            ],
            "properties": {
              "technicalOutcome": {},
              "unlockedCapabilities": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "spike"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "question",
              "timebox",
              "expectedDecision"
            ],
            "properties": {
              "question": {},
              "timebox": {},
              "expectedDecision": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "compliance"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "obligation",
              "authority",
              "deadline",
              "evidence"
            ],
            "properties": {
              "obligation": {},
              "authority": {},
              "deadline": {},
              "evidence": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "migration"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "sourceState",
              "targetState",
              "rollback"
            ],
            "properties": {
              "sourceState": {},
              "targetState": {},
              "rollback": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "operational"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "procedure",
              "owner",
              "evidence"
            ],
            "properties": {
              "procedure": {},
              "owner": {},
              "evidence": {}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "localTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedPath",
        "observedBytes",
        "observedContentHash"
      ],
      "properties": {
        "kind": {
          "const": "local"
        },
        "observedPath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "observedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "observedContentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "externalTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "externalId",
        "observedAt",
        "responseFingerprint",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "external"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "responseFingerprint": {
          "$ref": "#/$defs/hash"
        },
        "evidence": {
          "type": "object",
          "maxProperties": 32
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true
    },
    "typedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "canonicalFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "need": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "observedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "expectedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "technicalOutcome": {
          "type": "string",
          "minLength": 1
        },
        "unlockedCapabilities": {
          "$ref": "#/$defs/stringList"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "timebox": {
          "type": "string",
          "minLength": 1
        },
        "expectedDecision": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/stringList"
        },
        "sourceState": {
          "type": "string",
          "minLength": 1
        },
        "targetState": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
