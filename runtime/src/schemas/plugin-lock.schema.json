{
  "$id": "https://shipping-mode.dev/schemas/plugin-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginVersion", "templatePackFingerprint", "plugin"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pluginVersion": { "type": "string", "minLength": 1 },
    "templatePackFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "schemaVersion", "templatePack"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 },
        "templatePack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "fingerprint", "vendorSnapshot"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "vendorSnapshot": { "type": "string", "pattern": "^\\.planning/vendor/template-packs/sha256-[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
