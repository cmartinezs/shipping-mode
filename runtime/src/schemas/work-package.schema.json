{
  "$id": "https://shipping-mode.dev/schemas/work-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayId",
    "displayIdStatus",
    "releaseId",
    "releaseItemId",
    "scopeId",
    "title",
    "description",
    "status",
    "commitment",
    "design",
    "interfaces",
    "contracts",
    "dependencies",
    "guideRefs",
    "gateRequirements",
    "risks",
    "blockers",
    "resolution",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "displayId": {
      "type": "string",
      "pattern": "^WP-([0-9A-HJKMNP-TV-Z]{8}|[0-9A-HJKMNP-TV-Z]{12}|[0-9A-HJKMNP-TV-Z]{16}|[0-9A-HJKMNP-TV-Z]{26}|[0-9A-HJKMNP-TV-Z]{52})$"
    },
    "displayIdStatus": { "const": "ACTIVE" },
    "releaseId": { "$ref": "#/$defs/uuid" },
    "releaseItemId": { "$ref": "#/$defs/uuid" },
    "scopeId": { "$ref": "#/$defs/uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"], "minLength": 1 },
    "status": { "enum": ["DRAFT", "DONE", "CANCELLED", "SUPERSEDED"] },
    "commitment": { "enum": ["required", "optional"] },
    "design": { "type": ["string", "null"], "minLength": 1 },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedText" },
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedText" },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "uniqueItems": true
    },
    "guideRefs": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/guideRef" },
      "uniqueItems": true
    },
    "gateRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateRequirement" },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" },
      "uniqueItems": true
    },
    "resolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "reason", "approvedBy", "approvedAt", "riskAccepted", "replacementId", "operationId", "evidence"],
      "properties": {
        "type": { "enum": ["DONE", "CANCELLED", "SUPERSEDED"] },
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 1 },
        "riskAccepted": { "type": "boolean" },
        "replacementId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedText" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "createdBy", "updatedAt", "updatedBy", "operationId", "revision"],
      "properties": {
        "createdAt": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 },
        "updatedBy": { "type": "string", "minLength": 1 },
        "operationId": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "DRAFT" } }, "required": ["status"] },
      "then": { "properties": { "resolution": { "type": "null" } } },
      "else": { "properties": { "resolution": { "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "DONE" } }, "required": ["status"] },
      "then": { "properties": { "resolution": { "properties": { "type": { "const": "DONE" }, "replacementId": { "type": "null" } }, "required": ["type", "replacementId"], "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "CANCELLED" } }, "required": ["status"] },
      "then": { "properties": { "resolution": { "properties": { "type": { "const": "CANCELLED" }, "replacementId": { "type": "null" } }, "required": ["type", "replacementId"], "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "SUPERSEDED" } }, "required": ["status"] },
      "then": { "properties": { "resolution": { "properties": { "type": { "const": "SUPERSEDED" }, "replacementId": { "$ref": "#/$defs/uuid" } }, "required": ["type", "replacementId"], "type": "object" } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "namedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
        "summary": { "type": "string", "minLength": 1 },
        "detail": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "guideRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "kind", "id", "revision", "contentHash", "state", "usable", "capturedAt"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["task", "test"] },
        "id": { "$ref": "#/$defs/uuid" },
        "revision": { "$ref": "#/$defs/sha256" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "state": { "type": "string", "minLength": 1 },
        "usable": { "const": true },
        "capturedAt": { "type": "string", "minLength": 1 }
      }
    },
    "gateRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "applicability", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "applicability": { "enum": ["declared", "not_evaluated"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "scopeId", "guideKind", "guideId", "revision"],
          "properties": {
            "type": { "const": "guide" },
            "scopeId": { "$ref": "#/$defs/uuid" },
            "guideKind": { "enum": ["task", "test"] },
            "guideId": { "$ref": "#/$defs/uuid" },
            "revision": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "summary", "createdAt", "createdBy"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "createdAt", "createdBy"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 },
        "resolvedAt": { "type": ["string", "null"], "minLength": 1 },
        "resolvedBy": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
