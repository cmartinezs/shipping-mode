{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipping-mode.local/spikes/host-mcp-bridge/bridge-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "nonceHash",
    "sessionId",
    "projectRootHash",
    "expectedServer",
    "expectedTool",
    "toolName",
    "toolUseId",
    "toolInputHash",
    "toolResponseHash",
    "capturedAt",
    "expiresAt",
    "responseBytes",
    "durationMs",
    "response",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "status": { "enum": ["CAPTURED", "CONSUMED"] },
    "nonceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sessionId": { "type": "string", "minLength": 1 },
    "projectRootHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expectedServer": { "type": "string", "minLength": 1 },
    "expectedTool": { "type": "string", "minLength": 1 },
    "toolName": { "type": "string", "minLength": 1 },
    "toolUseId": { "type": "string", "minLength": 1 },
    "toolInputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "toolResponseHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "responseBytes": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "number", "minimum": 0 },
    "response": true,
    "signature": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
  }
}
